    "\n",
    "# ============================================================\n",
    "# CELL 5: GEMMA 2 2B — FAST BENCHMARK + PREDICTIONS\n",
    "# ============================================================\n",
    "\n",
    "import os\n",
    "import re\n",
    "import json\n",
    "import time\n",
    "import torch\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "from collections import Counter\n",
    "from rouge_score import rouge_scorer\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 1. INITIALIZE ALL SETTINGS\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "MAX_SOURCE_LENGTH = 512\n",
    "MAX_TARGET_LENGTH = 128\n",
    "\n",
    "MAX_EVAL_SAMPLES = 5\n",
    "MAX_TEST_SAMPLES = 5\n",
    "\n",
    "MODEL_ID = globals().get(\"MODEL_ID\", \"google/gemma-2-2b-it\")\n",
    "\n",
    "RESULTS_DIR = globals().get(\n",
    "    \"RESULTS_DIR\",\n",
    "    \"/content/drive/MyDrive/JU_Benchmark_Project/results\"\n",
    ")\n",
    "os.makedirs(RESULTS_DIR, exist_ok=True)\n",
    "\n",
    "# Verify required objects\n",
    "if \"model\" not in globals() or \"tokenizer\" not in globals():\n",
    "    raise RuntimeError(\"Run Cell 4 first to load Gemma.\")\n",
    "\n",
    "if \"val_df\" not in globals():\n",
    "    raise RuntimeError(\"Run Cell 3 first to load validation data.\")\n",
    "\n",
    "if val_df.empty:\n",
    "    raise ValueError(\"Validation dataset is empty.\")\n",
    "\n",
    "if \"Abstract\" not in val_df.columns or \"Highlights\" not in val_df.columns:\n",
    "    raise ValueError(\"Validation CSV needs Abstract and Highlights columns.\")\n",
    "\n",
    "if tokenizer.pad_token_id is None:\n",
    "    tokenizer.pad_token = tokenizer.eos_token\n",
    "\n",
    "print(\"Gemma benchmark initialized!\")\n",
    "print(\"Model:\", MODEL_ID)\n",
    "print(\"Validation samples:\", min(MAX_EVAL_SAMPLES, len(val_df)))\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 2. PROMPT GENERATION\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "def make_prompt(abstract):\n",
    "\n",
    "    messages = [\n",
    "        {\n",
    "            \"role\": \"user\",\n",
    "            \"content\": (\n",
    "                \"Generate concise, accurate scientific research \"\n",
    "                \"highlights based only on the following abstract. \"\n",
    "                \"Do not add unsupported information.\\n\\n\"\n",
    "                + str(abstract)\n",
    "            )\n",
    "        }\n",
    "    ]\n",
    "\n",
    "    return tokenizer.apply_chat_template(\n",
    "        messages,\n",
    "        tokenize=False,\n",
    "        add_generation_prompt=True\n",
    "    )\n",
    "\n",
    "\n",
    "# Preserve the final assistant-generation prompt when truncating.\n",
    "tokenizer.truncation_side = \"left\"\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 3. GENERATION FUNCTION\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "def generate_one(abstract):\n",
    "\n",
    "    prompt = make_prompt(abstract)\n",
    "\n",
    "    inputs = tokenizer(\n",
    "        prompt,\n",
    "        return_tensors=\"pt\",\n",
    "        max_length=MAX_SOURCE_LENGTH,\n",
    "        truncation=True\n",
    "    ).to(model.device)\n",
    "\n",
    "    if torch.cuda.is_available():\n",
    "        torch.cuda.synchronize()\n",
    "\n",
    "    start = time.perf_counter()\n",
    "\n",
    "    with torch.inference_mode():\n",
    "\n",
    "        output = model.generate(\n",
    "            **inputs,\n",
    "            max_new_tokens=MAX_TARGET_LENGTH,\n",
    "            do_sample=False,\n",
    "            num_beams=1,\n",
    "            repetition_penalty=1.1,\n",
    "            pad_token_id=tokenizer.pad_token_id,\n",
    "            eos_token_id=tokenizer.eos_token_id,\n",
    "            use_cache=True\n",
    "        )\n",
    "\n",
    "    if torch.cuda.is_available():\n",
    "        torch.cuda.synchronize()\n",
    "\n",
    "    elapsed = time.perf_counter() - start\n",
    "\n",
    "    generated_tokens = output[\n",
    "        0, inputs[\"input_ids\"].shape[1]:\n",
    "    ]\n",
    "\n",
    "    prediction = tokenizer.decode(\n",
    "        generated_tokens,\n",
    "        skip_special_tokens=True\n",
    "    ).strip()\n",
    "\n",
    "    return prediction, elapsed, len(generated_tokens)\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 4. VALIDATION BENCHMARK\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "eval_df = val_df.head(MAX_EVAL_SAMPLES).copy()\n",
    "\n",
    "predictions = []\n",
    "latencies = []\n",
    "token_counts = []\n",
    "\n",
    "print(\"\\nStarting Gemma validation benchmark...\\n\")\n",
    "\n",
    "for i, abstract in enumerate(eval_df[\"Abstract\"]):\n",
    "\n",
    "    pred, latency, tokens = generate_one(abstract)\n",
    "\n",
    "    predictions.append(pred)\n",
    "    latencies.append(latency)\n",
    "    token_counts.append(tokens)\n",
    "\n",
    "    print(\n",
    "        f\"Sample {i+1}/{len(eval_df)} | \"\n",
    "        f\"Latency: {latency:.2f}s | \"\n",
    "        f\"Tokens: {tokens}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 5. QUALITY METRICS\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "scorer = rouge_scorer.RougeScorer(\n",
    "    [\"rougeL\"],\n",
    "    use_stemmer=True\n",
    ")\n",
    "\n",
    "rouge_scores = [\n",
    "    scorer.score(\n",
    "        str(ref),\n",
    "        str(pred)\n",
    "    )[\"rougeL\"].fmeasure\n",
    "\n",
    "    for ref, pred in zip(\n",
    "        eval_df[\"Highlights\"],\n",
    "        predictions\n",
    "    )\n",
    "]\n",
    "\n",
    "\n",
    "def tokenize_words(text):\n",
    "\n",
    "    return re.findall(\n",
    "        r\"\\b[a-zA-Z0-9]+\\b\",\n",
    "        str(text).lower()\n",
    "    )\n",
    "\n",
    "\n",
    "def overlap_metrics(pred, source, reference):\n",
    "\n",
    "    p = Counter(tokenize_words(pred))\n",
    "    s = Counter(tokenize_words(source))\n",
    "    r = Counter(tokenize_words(reference))\n",
    "\n",
    "    total_p = sum(p.values())\n",
    "    total_r = sum(r.values())\n",
    "\n",
    "    source_overlap = sum((p & s).values())\n",
    "    target_overlap = sum((p & r).values())\n",
    "\n",
    "    source_precision = (\n",
    "        source_overlap / total_p if total_p else 0\n",
    "    )\n",
    "\n",
    "    target_precision = (\n",
    "        target_overlap / total_p if total_p else 0\n",
    "    )\n",
    "\n",
    "    target_recall = (\n",
    "        target_overlap / total_r if total_r else 0\n",
    "    )\n",
    "\n",
    "    f1 = (\n",
    "        2 * target_precision * target_recall /\n",
    "        (target_precision + target_recall)\n",
    "        if target_precision + target_recall else 0\n",
    "    )\n",
    "\n",
    "    return source_precision, f1\n",
    "\n",
    "\n",
    "scores = [\n",
    "    overlap_metrics(p, s, r)\n",
    "\n",
    "    for p, s, r in zip(\n",
    "        predictions,\n",
    "        eval_df[\"Abstract\"],\n",
    "        eval_df[\"Highlights\"]\n",
    "    )\n",
    "]\n",
    "\n",
    "avg_grounding = float(\n",
    "    np.mean([x[0] for x in scores])\n",
    ")\n",
    "\n",
    "avg_f1 = float(\n",
    "    np.mean([x[1] for x in scores])\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 6. CREATE BENCHMARK REPORT\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "benchmark = {\n",
    "\n",
    "    \"model\": \"gemma-2-2b\",\n",
    "    \"model_id\": MODEL_ID,\n",
    "\n",
    "    \"evaluation_samples\": len(eval_df),\n",
    "\n",
    "    \"overall_quality_rougeL_f1\": float(\n",
    "        np.mean(rouge_scores)\n",
    "    ),\n",
    "\n",
    "    \"f1_score_target\": avg_f1,\n",
    "\n",
    "    \"source_grounding_precision\": avg_grounding,\n",
    "\n",
    "    # Lexical proxy, NOT a verified hallucination rate.\n",
    "    \"lexical_non_grounded_fraction\": 1.0 - avg_grounding,\n",
    "\n",
    "    \"wall_clock_latency_sec\": float(\n",
    "        np.mean(latencies)\n",
    "    ),\n",
    "\n",
    "    \"total_wall_clock_sec\": float(\n",
    "        np.sum(latencies)\n",
    "    ),\n",
    "\n",
    "    \"throughput_tokens_per_sec\": float(\n",
    "        sum(token_counts) / max(sum(latencies), 1e-6)\n",
    "    ),\n",
    "\n",
    "    \"max_source_length\": MAX_SOURCE_LENGTH,\n",
    "    \"max_target_length\": MAX_TARGET_LENGTH,\n",
    "\n",
    "    \"fine_tuning\": False,\n",
    "    \"quantization\": \"4-bit NF4\",\n",
    "    \"evaluation_type\": \"Zero-shot inference\"\n",
    "}\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 7. SAVE BENCHMARK JSON\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "benchmark_path = os.path.join(\n",
    "    RESULTS_DIR,\n",
    "    \"benchmark_gemma-2-2b.json\"\n",
    ")\n",
    "\n",
    "with open(benchmark_path, \"w\") as f:\n",
    "\n",
    "    json.dump(\n",
    "        benchmark,\n",
    "        f,\n",
    "        indent=4\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 8. SAVE VALIDATION PREDICTIONS\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "val_output = eval_df.copy()\n",
    "\n",
    "val_output[\"Predicted_Highlights\"] = predictions\n",
    "\n",
    "val_path = os.path.join(\n",
    "    RESULTS_DIR,\n",
    "    \"gemma_validation_predictions.csv\"\n",
    ")\n",
    "\n",
    "val_output.to_csv(\n",
    "    val_path,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 9. PRINT BENCHMARK\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "print(\"\\n========================================\")\n",
    "print(\"       GEMMA 2 2B BENCHMARK RESULTS\")\n",
    "print(\"========================================\")\n",
    "\n",
    "for key, value in benchmark.items():\n",
    "\n",
    "    print(f\"{key}: {value}\")\n",
    "\n",
    "print(\"\\nValidation results saved successfully!\")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 10. MASKED TEST PREDICTIONS\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "if \"test_df\" in globals() and test_df is not None:\n",
    "\n",
    "    if len(test_df) > 0 and \"Abstract\" in test_df.columns:\n",
